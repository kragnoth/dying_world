//
// This config uses NORMALIZED WEIGHTS based on mod-intended spawn rates.
// Weights have been adjusted to:
//   1. Equalize representation across mods
//   2. Preserve internal mod ratios (small:medium:large)
//   3. Account for structure spacing (rarer structures = higher weights)
//
// ═══════════════════════════════════════════════════════════════
//  📋 NEXT STEPS:
//  1. Review weights below (higher = spawns more often)
//  2. Use biome_frequency{} to control spawn density per biome
//  3. Copy to: config/multivillageselector.json5
//  4. Restart Minecraft
// ═══════════════════════════════════════════════════════════════
//
// 📖 For complete documentation, see:
//    https://github.com/RhettL/multi-village-selector/blob/master/docs/Configuration.md
//
// ═══════════════════════════════════════════════════════════════

{
  enabled: true,

  // Structure sets to block (prevents double-spawning, MVS controls these instead)
  block_structure_sets: [
    // LIKELY village sets (review - remove if incorrect)
    "create_pillagers_arise:createpillagervillage",
    "towns_and_towers:towns",
  ],

  // Structure sets to intercept (MVS controls structure selection)
  intercept_structure_sets: [
    "minecraft:villages",
  ],

  // Structure pool - MVS selects from this list
  // biomes controls spawn weights per biome (same pattern system as biome_frequency)
  //
  // Supports: Direct IDs ("minecraft:plains": 10), Tags ("#minecraft:is_plains": 10), Patterns ("minecraft:*": 5)
  // Specificity: More specific patterns win, literal IDs beat tags, tie-breaker = higher weight
  structure_pool: [

    // === ATMOSPHERIC ===

    // minecraft:villages
    { structure: "atmospheric:village_scrubland",
      biomes: {
        "#atmospheric:has_structure/village_scrubland": 25,
      } },

    // === MINECRAFT ===

    // minecraft:villages
    { structure: "minecraft:village_desert",
