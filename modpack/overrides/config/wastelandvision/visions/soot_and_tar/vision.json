        "*:block/*grass*",
        "*:block/*fern*",
        "*:block/dirt",
        "*:block/coarse_dirt",
        "*:block/podzol*",
        "*:block/rooted_dirt",
        "*:block/moss*",
        "*:block/*flower*",
        "*:block/*tulip*",
