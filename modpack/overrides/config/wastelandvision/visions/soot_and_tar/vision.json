        5,
        3,
        2
      ],
      "clump": 0,
      "contrast": 0.85,
      "gamma": 0.9,
      "_comment": "Blighted canopies: the leaf pattern is kept (no holes), recoloured per species into one of three dead palettes - golden-brown, rust, umber."
    }
  },
  "decals": {
    "_comment": "World-space grime sheets (0.15): one generated, softly translucent texture spans 'blocks' x 'blocks' blocks; each face shows its own slice, so patches and drips run across block edges and only repeat every N blocks. Sets opt in with \"decal\": \"<name>\". Walls get drips; floors use floor_coverage and no drips.",
    "soot": {
      "blocks": 16,
      "pixels": 16,
      "shades": [
        "#0c0a08",
        "#16120e",
        "#211a14"
      ],
      "coverage": 0.38,
      "patch_size": 3,
      "drips": 0.8,
      "drip_min": 10,
      "drip_max": 64,
      "floor_coverage": 0.45,
      "opacity": 0.82
    },
    "dust": {
      "blocks": 16,
      "pixels": 16,
      "shades": [
        "#6e675c",
        "#857d70",
        "#9b9384"
      ],
      "coverage": 0.24,
      "patch_size": 4,
      "drips": 0,
      "floor_coverage": 1.0,
      "opacity": 0.4
    }
  },
  "plants": {
    "visible_percent": 100,
    "hide_hidden_outlines": true
  },
  "hazards": {
    "_comment": "Anything a rule would hide but that still hurts (berry bushes, modded thorns...) shows tar thorns; solid or climbable blocks are never hidden.",
    "marker": "tar_thorns",
    "blocks": [],
    "ignore": []
  },
  "atmosphere": {
    "grass": {
      "color": "#7d7a52",
      "amount": 0.38,
      "brightness": 1.0
    },
    "foliage": {
      "color": "#6f6c49",
      "amount": 0.38,
      "brightness": 1.0
    },
    "water": {
      "color": "#3f3a2c",
      "amount": 0.5,
      "brightness": 0.85
    },
    "sky": {
      "color": "#8f8172",
      "amount": 0.55
    },
    "fog": {
      "color": "#857766",
      "amount": 0.55
    },
    "clouds": {
      "color": "#6f6459",
      "amount": 0.6
    },
    "ambient_particles": [
      {
        "type": "minecraft:ash",
        "probability": 0.0055,
        "sky_only": true
      },
      {
        "type": "minecraft:white_ash",
        "probability": 0.0012,
        "sky_only": true
      }
    ],
    "post_shader": "soot:shaders/post/smog.json",
    "fog_distance": 160
  },
  "variation": {
    "_comment": "World-space variation (0.14): each block picks one of its set's 'variants' (clean -> grimy) from smooth noise of 'scale' blocks plus 'jitter' per block, so neighbours are similar but never identical. 'grime' darkens block corners by 3D world noise, so soot shading flows across block edges. Raise grime.strength / a set's variant_spread for more contrast between clean and dirty patches.",
    "scale": 8,
    "jitter": 0.35,
    "grime": {
      "strength": 0.1,
      "scale": 10,
      "coverage": 0.45,
      "color": "#2a221a"
    }
  },
  "rules": [
    {
      "_comment": "The Nether keeps its fungus wood.",
      "if": {
        "id_contains": [
          "crimson",
          "warped"
        ]
      },
      "then": "keep"
    },
    {
      "_comment": "Already grimy by design.",
      "if": {
        "namespace": "rustandrebar"
      },
      "then": "keep"
    },
    {
      "if": {
        "namespace": "rustandrebar_blocks"
      },
      "then": "keep"
    },
    {
      "if": {
        "namespace": "tarbound"
      },
      "then": "keep"
    },
    {
      "_comment": "The one real 'swap': mud and mangrove mud turn to tar.",
      "if": {
        "blocks": [
          "minecraft:mud",
          "minecraft:muddy_mangrove_roots"
        ],
        "full_cube": true
      },
      "then": "swap",
      "standin": "tar_mud",
      "name": "Tarred %s"
    },
    {
      "_comment": "Built-in dead forms (dead coral...).",
      "then": "native",
      "template": "{namespace}:dead_{path}",
      "name": "Dead %s"
    },
    {
      "_comment": "Snow layers fall as ash when Supplementaries is installed (layer count kept); otherwise grimy_snow below.",
      "if": {
        "blocks": [
          "minecraft:snow"
        ]
      },
      "then": "swap",
      "standin": "supplementaries:ash",
      "optional": true,
      "name": "Ash"
    },
    {
      "_comment": "Living grass with dead tufts mixed in; inside blighted (dead-forest) areas it's mostly dead. 'self' keeps the real plant.",
      "if": {
        "blocks": [
          "minecraft:short_grass"
        ],
        "occludes": false
      },
      "then": "plant",
      "visible_percent": 100,
      "standins": [
        {
          "id": "self",
          "weight": 72
        },
        {
          "id": "soot_grass",
          "weight": 18
        },
        {
          "id": "cinder_weed",
          "weight": 6
        },
        {
          "id": "minecraft:dead_bush",
          "weight": 4
        }
      ],
      "blight": {
        "percent": 30,
        "scale": 14,
        "visible_percent": 85,
        "standins": [
          {
            "id": "soot_grass",
            "weight": 55
          },
          {
            "id": "cinder_weed",
            "weight": 20
          },
          {
            "id": "minecraft:dead_bush",
            "weight": 15
          },
          {
            "id": "self",
            "weight": 10
          }
        ]
      }
    },
    {
      "if": {
        "blocks": [
          "minecraft:tall_grass"
        ],
        "occludes": false
      },
      "then": "plant",
      "visible_percent": 100,
      "standins": [
        {
          "id": "soot_grass",
          "weight": 70
        },
        {
          "id": "cinder_weed",
          "weight": 30
        }
      ],
      "tall": {
        "id": "self",
        "chance": 75
      },
      "blight": {
        "percent": 30,
        "scale": 14,
        "visible_percent": 85,
        "standins": [
          {
            "id": "soot_grass",
            "weight": 60
          },
          {
            "id": "minecraft:dead_bush",
            "weight": 40
          }
        ],
        "tall": {
          "id": "soot_tall_grass",
          "chance": 70
        }
      }
    },
    {
      "if": {
        "blocks": [
          "minecraft:fern",
          "minecraft:large_fern"
        ],
        "occludes": false
      },
      "then": "plant",
      "visible_percent": 100,
      "standins": [
        {
          "id": "self",
          "weight": 70
        },
        {
          "id": "cinder_weed",
          "weight": 30
        }
      ],
      "tall": {
        "id": "self",
        "chance": 80
      },
      "blight": {
        "percent": 30,
        "scale": 14,
        "visible_percent": 80,
        "standins": [
          {
            "id": "cinder_weed",
            "weight": 70
          },
          {
            "id": "soot_grass",
            "weight": 30
          }
        ],
        "tall": {
          "id": "soot_tall_grass",
          "chance": 50
        }
      }
    },
    {
      "_comment": "Most flowers survive; some are choked. In blighted areas few survive.",
      "if": {
        "blocks": [
          "#minecraft:small_flowers",
          "#minecraft:tall_flowers"
        ],
        "occludes": false,
        "not_blocks": [
          "minecraft:wither_rose"
        ]
      },
      "then": "plant",
      "visible_percent": 100,
      "standins": [
        {
          "id": "self",
          "weight": 70
        },
        {
          "id": "choked_flower",
          "weight": 30
        }
      ],
      "tall": {
        "id": "self",
        "chance": 80
      },
      "blight": {
        "percent": 30,
        "scale": 14,
        "visible_percent": 70,
        "standins": [
          {
            "id": "choked_flower",
            "weight": 60
          },
          {
            "id": "soot_grass",
            "weight": 25
          },
          {
            "id": "self",
            "weight": 15
          }
        ],
        "tall": {
          "id": "soot_tall_grass",
          "chance": 50
        }
      }
    },
    {
      "_comment": "Crops: every growth stage stays readable.",
      "if": {
        "blocks": [
          "#minecraft:crops"
        ],
        "occludes": false,
        "not_namespaces": [
          "create",
          "framedblocks",
          "copycats",
          "chipped_framed",
          "sophisticatedstorage",
          "sophisticatedbackpacks"
        ]
      },
      "then": "retexture",
      "recolor": "soot_crops"
    },
    {
      "if": {
        "blocks": [
          "#minecraft:leaves"
        ]
      },
      "then": "retexture",
      "recolor": "grimy_foliage",
      "tint": "keep",
      "blight": {
        "percent": 30,
        "scale": 14,
        "recolor": [
          "dead_leaves"
        ],
        "tint": "drop"
      }
    },
    {
      "if": {
        "blocks": [
          "#minecraft:logs"
        ]
      },
      "then": "retexture",
      "recolor": [
        "grimy_stripped",
        "grimy_bark"
      ],
      "blight": {
        "percent": 30,
        "scale": 14,
        "recolor": [
          "dead_stripped",
          "dead_bark"
        ]
      }
    },
    {
      "if": {
        "blocks": [
          "#minecraft:planks",
          "#minecraft:wooden_stairs",
          "#minecraft:wooden_slabs",
          "#minecraft:wooden_fences",
          "#minecraft:fence_gates",
          "#minecraft:wooden_doors",
          "#minecraft:wooden_trapdoors",
          "#minecraft:wooden_buttons",
          "#minecraft:wooden_pressure_plates",
          "#c:barrels/wooden"
        ],
        "not_id_contains": [
          "copycat"
        ],
        "not_namespaces": [
          "create",
          "framedblocks",
          "copycats",
          "chipped_framed",
          "sophisticatedstorage",
          "sophisticatedbackpacks"
        ]
      },
      "then": "retexture",
      "recolor": "creosote_wood"
    },
    {
      "_comment": "Ground and field plants: same colours, a little dulled and soot-flecked. Nothing is hidden.",
      "if": {
        "blocks": [
          "minecraft:grass_block",
          "#minecraft:dirt",
          "minecraft:moss_block",
          "minecraft:moss_carpet",
          "#minecraft:small_flowers",
          "#minecraft:tall_flowers",
          "#minecraft:replaceable_by_trees",
          "#minecraft:saplings"
        ],
        "not_blocks": [
          "#minecraft:leaves",
          "minecraft:water",
          "minecraft:seagrass",
          "minecraft:tall_seagrass"
        ],
        "not_namespaces": [
          "create",
          "framedblocks",
          "copycats",
          "chipped_framed",
          "sophisticatedstorage",
          "sophisticatedbackpacks"
        ]
      },
      "then": "retexture",
      "recolor": "grimy_growth",
      "tint": "keep"
    },
    {
      "_comment": "Snow is a little grimy, not grey.",
      "if": {
        "blocks": [
          "minecraft:snow",
          "minecraft:snow_block",
          "minecraft:powder_snow"
        ]
      },
      "then": "retexture",
      "recolor": "grimy_snow"
    },
    {
      "if": {
        "blocks": [
          "#c:sands",
          "#c:sandstone/blocks",
          "#c:sandstone/slabs",
          "#c:sandstone/stairs",
          "#c:gravels",
          "minecraft:suspicious_sand",
          "minecraft:suspicious_gravel"
        ],
        "not_blocks": [
          "minecraft:soul_sand"
        ],
        "not_namespaces": [
          "create",
          "framedblocks",
          "copycats",
          "chipped_framed",
          "sophisticatedstorage",
          "sophisticatedbackpacks"
        ]
      },
      "then": "retexture",
      "recolor": "sooty_sand"
    },
    {
      "if": {
