{
  "_readme": "Soot & Tar - a LIGHTLY polluted dieselpunk world. Nothing is replaced wholesale: every block keeps its own colour and model, slightly greyed and darkened, with soft soot blotches and rain-streaked drips (the 'stain' recolour option). Only mud becomes tar. Turn the intensity up via each set's saturation/brightness/stain.strength, or swap the unused stand-ins back in (see extras/ for heavier examples).",
  "name": "Soot & Tar",
  "description": "Industrial pollution: soot-stained stone and timber, dulled foliage, grimy snow, tar in the mud, a brown haze and a little drifting ash.",
  "standins": {
    "sooted_turf": {
      "type": "cube_bottom_top",
      "textures": {
        "top": "soot:block/sooted_turf_top",
        "side": "soot:block/sooted_turf_side",
        "bottom": "soot:block/soot_soil"
      }
    },
    "soot_soil": {
      "type": "cube",
      "textures": {
        "all": "soot:block/soot_soil"
      }
    },
    "tar_mud": {
      "type": "cube_bottom_top",
      "textures": {
        "top": "soot:block/tar_mud",
        "side": "soot:block/soot_soil",
        "bottom": "soot:block/soot_soil"
      }
    },
    "soot_moss": {
      "type": "cube",
      "textures": {
        "all": "soot:block/soot_moss"
      }
    },
    "soot_moss_carpet": {
      "type": "carpet",
      "textures": {
        "wool": "soot:block/soot_moss"
      }
    },
    "soot_grass": {
      "type": "cross",
      "textures": {
        "cross": "soot:block/soot_grass"
      }
    },
    "cinder_weed": {
      "type": "cross",
      "textures": {
        "cross": "soot:block/cinder_weed"
      }
    },
    "choked_flower": {
      "type": "cross",
      "textures": {
        "cross": "soot:block/choked_flower"
      }
    },
    "tar_thorns": {
      "type": "cross",
      "textures": {
        "cross": "soot:block/tar_thorns"
      }
    },
    "soot_tall_grass": {
      "type": "tall_cross",
      "textures": {
        "bottom": "soot:block/soot_tall_grass_bottom",
        "top": "soot:block/soot_tall_grass_top"
      }
    }
  },
  "recolor_sets": {
    "_comment": "All sets keep the block's own colour (saturation/brightness) and add a light stain. Raise stain.strength / lower brightness to make the world dirtier.",
